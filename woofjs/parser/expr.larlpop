// src/parser/expr.lalrpop
// Tell lalrpop the tokens come from your enum type
extern crate crate;

use crate::token::Token;

Expr: i64 = {
    <l:Expr> "+" <r:Term> => l + r,
    <l:Expr> "-" <r:Term> => l - r,
    Term,
};

Term: i64 = {
    <l:Term> "*" <r:Factor> => l * r,
    <l:Term> "/" <r:Factor> => l / r,
    Factor,
};

Factor: i64 = {
    Number,
    "(" <e:Expr> ")" => e,
};

Number: i64 = {
    <n:Token> if matches!(n, Token::Number) => {
        // Extract string from Token variant to parse
        // You'll implement this in the tokenizer wrapper
        parse_number(n)
    },
};

VariableDefinition: VariableDefinition = {
    <var_def:Token> <id:Token> <eq:Token> <expr:Expr> <semi:Token> if matches!(var_def, Token::VariableDefinitionNonStatic) && matches!(id, Token::Identifier) && matches!(eq, Token::Equal) && matches!(semi, Token::Semicolon) => {
        VariableDefinition {
            name: extract_identifier(id),
            kind: VariableDefinitionKind::NonStatic,
            value: Some(expr),
        }
    },
    <var_def:Token> <id:Token> <eq:Token> <expr:Expr> <semi:Token> if matches!(var_def, Token::VariableDefinitionStatic) && matches!(id, Token::Identifier) && matches!(eq, Token::Equal) && matches!(semi, Token::Semicolon) => {
        VariableDefinition {
            name: extract_identifier(id),
            kind: VariableDefinitionKind::Static,
            value: Some(expr),
        }
    }
};

